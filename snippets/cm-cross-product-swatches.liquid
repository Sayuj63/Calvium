{%- comment -%}
  cm-cross-product-swatches.liquid — rebuilt 2026-08
  Was: <a href> links to separate per-colour product pages (redirect on click).
  Now: inline cm-picker__thumb buttons on the current product's Color option.
       Works with calvium-product-immersive.liquid / luxury / editorial.
       Requires products to have Option1 Name = "Color" with per-variant images.
{%- endcomment -%}

{%- liquid
  assign cm_color_option = nil
  assign cm_color_index = nil
  for opt in product.options_with_values
    assign _n = opt.name | downcase
    if _n contains 'color' or _n contains 'colour'
      assign cm_color_option = opt
      assign cm_color_index = forloop.index0
      break
    endif
  endfor
-%}

{%- if cm_color_option != blank and cm_color_option.values.size > 1 -%}
  <div class="cm-picker cm-inline-color-swatches">
    <p class="cm-picker__label">
      <span>Color:</span>
      <strong data-cm-picker-value>{{ cm_color_option.selected_value }}</strong>
    </p>
    <div class="cm-picker__row">
      {%- for value in cm_color_option.values -%}
        {%- assign _matched = nil -%}
        {%- for v in product.variants -%}
          {%- if v.options[cm_color_index] == value -%}
            {%- assign _matched = v -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <button
          type="button"
          class="cm-picker__thumb{% if value == cm_color_option.selected_value %} is-active{% endif %}{% unless _matched.available %} is-sold-out{% endunless %}"
          data-option-name="{{ cm_color_option.name | escape }}"
          data-option-value="{{ value | escape }}"
          title="{{ value }}"
          aria-label="{{ value }}{% unless _matched.available %} – sold out{% endunless %}"
        >
          {%- if _matched.image -%}
            <img src="{{ _matched.image | image_url: width: 120 }}"
                 alt="{{ value | escape }}" width="44" height="58" loading="lazy">
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
