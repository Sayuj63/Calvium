{%- comment -%}
  Cross-product color swatches.

  Renders swatches for OTHER products in the same "color-group". Each swatch
  is an <a href="{{ sibling.url }}"> so clicking navigates to the other color's
  product page (not switching a variant inside one product).

  Grouping
  --------
  Each per-color product is tagged with:
    color-group:calvium-arcus     (identifies the family)
    color:black                   (identifies this product's color)

  Include with:
    {% render 'cm-cross-product-swatches', product: product %}
{%- endcomment -%}

{%- liquid
  assign group_id = ''
  assign this_color_label = ''
  for t in product.tags
    if t contains 'color-group:'
      assign group_id = t | remove: 'color-group:' | strip
    elsif t contains 'color:'
      assign this_color_label = t | remove: 'color:' | replace: '-', ' ' | capitalize
    endif
  endfor
-%}

{%- if group_id != blank -%}
  {%- assign target_tag = 'color-group:' | append: group_id -%}
  {%- assign siblings = collections.all.products | where: 'tags', target_tag -%}

  {%- if siblings.size > 1 -%}
    <div class="cm-picker cm-cross-swatches" data-cm-cross-group="{{ group_id }}">
      <p class="cm-picker__label" style="text-align:center;">
        <span>Color:</span>
        <strong>{{ this_color_label | default: 'Select' }}</strong>
      </p>
      <div class="cm-cross-swatches__row" style="justify-content:center;">
        {%- for sib in siblings -%}
          {%- assign sib_color_label = '' -%}
          {%- for t in sib.tags -%}
            {%- if t contains 'color:' -%}
              {%- unless t contains 'color-group' -%}
                {%- assign sib_color_label = t | remove: 'color:' | replace: '-', ' ' | capitalize -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
          <a
            href="{{ sib.url }}"
            class="cm-cross-swatch {% if sib.id == product.id %}is-active{% endif %}"
            title="{{ sib_color_label | default: sib.title | escape }}"
            aria-label="{{ sib_color_label | default: sib.title | escape }}"
            {% if sib.id == product.id %}aria-current="page"{% endif %}
          >
            <span class="cm-cross-swatch__thumb">
              {%- if sib.featured_image -%}
                <img
                  src="{{ sib.featured_image | image_url: width: 120 }}"
                  alt="{{ sib_color_label | default: sib.title | escape }}"
                  width="48" height="60" loading="lazy">
              {%- endif -%}
            </span>
            <span class="cm-cross-swatch__name">{{ sib_color_label | default: sib.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
