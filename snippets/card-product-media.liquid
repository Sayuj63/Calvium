{%- comment -%}
  Calvium — product-card media renderer.
  Now delegates to `cm-image-fit` so images are PRE-CROPPED by Shopify's CDN
  to the exact aspect ratio of the card frame. Fixes site-wide "images cut
  from the sides / heads chopped" bug — see snippets/cm-image-fit.liquid.

  Params (from parent card renderer):
  - card_product          Product object                                (required)
  - show_secondary_image  Bool — hover-swap the 2nd media               (optional)
  - media_aspect_ratio    'square' | 'portrait' | 'adapt'               (optional)
  - lazy_load             Bool                                          (optional)
  - image_shape, section, block, widths, sizes                          (optional)
{%- endcomment -%}

{%- capture sizes -%}
  {%- render 'util-product-media-sizes-attr', block: block, section: section, settings: settings, is_single_column: is_single_column, needs_both_sizes: needs_both_sizes -%}
{%- endcapture -%}

{%- capture f_media_alt -%}
  {{ 'content.product_image_main' | t }}
{%- endcapture -%}
{%- capture media_alt -%}
  {{ 'content.product_image_secondary' | t }}
{%- endcapture -%}

{%- liquid
  assign f_media = card_product.featured_media
  assign media = card_product.media

  assign f_media_alt = f_media.alt | default: card_product.title | append: ' ' | append: f_media_alt | strip
  assign media_alt = media.alt | default: card_product.title | append: ' ' | append: media_alt | strip

  assign sizes = sizes | strip

  # ------------------------------------------------------------
  # Target aspect ratio for the frame.
  # Mirrors the exact logic in card-product.liquid / card-product-flex.liquid /
  # product-card-compare.liquid / cart-popular-product-card.liquid so the
  # image ratio ALWAYS matches the CSS container ratio → no cropping.
  # ------------------------------------------------------------
  assign target_ratio = 1
  if f_media and media_aspect_ratio == 'portrait'
    assign target_ratio = 0.8
  elsif f_media and media_aspect_ratio == 'adapt' and f_media.aspect_ratio and f_media.aspect_ratio > 0
    assign target_ratio = f_media.aspect_ratio
  elsif f_media and media_aspect_ratio == 'landscape'
    assign target_ratio = 1.2857
  endif
  if target_ratio == 0 or target_ratio == nil
    assign target_ratio = 1
  endif

  assign f_widths = widths | default: '240,352,500,700,900,1200,1600'
  assign m_widths = widths | default: '240,352,500,700,900,1200,1600'

  unless lazy_load == false
    assign loading = 'lazy'
  endunless

  if collection and collection.handle
    assign href_product_url = '/collections/' | append: collection.handle | append: '/products/' | append: card_product.handle
  else
    assign href_product_url = card_product.url
  endif

  # Focal-point CSS variable stays available as a hint for the CDN AND as an
  # object-position fallback if the CDN ever returns an un-cropped image.
  assign focal_point_style = ''
  if f_media.presentation.focal_point != blank
    assign focal_point_style = '--image-focal-point: ' | append: media[0].presentation.focal_point | append: ';'
  endif
  assign secondary_focal_point_style = ''
  if media[1].presentation.focal_point != blank
    assign secondary_focal_point_style = '--image-focal-point: ' | append: media[1].presentation.focal_point | append: ';'
  endif
-%}

<card-media class="card__media block{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }}{% endif %}">
  <div class="media media--transparent media--hover-effect" id="CardProductMedia-Content-{{ section.id }}-{{ card_product.id }}">
    {%- if f_media -%}
      {%- render 'cm-image-fit',
        image: f_media,
        ratio: target_ratio,
        width: 900,
        widths: f_widths,
        sizes: sizes,
        loading: loading,
        alt: f_media_alt,
        class: 'motion-reduce',
        style: focal_point_style
      -%}
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if media[1] != null and show_secondary_image -%}
      {%- case media[1].media_type -%}
        {%- when 'image' -%}
          {%- render 'cm-image-fit',
            image: media[1],
            ratio: target_ratio,
            width: 900,
            widths: m_widths,
            sizes: sizes,
            loading: 'lazy',
            alt: media_alt,
            class: 'motion-reduce',
            id: secondary_media_id,
            style: secondary_focal_point_style
          -%}
        {%- when 'video', 'external_video' -%}
          {%- render 'video',
            video: media[1],
            widths: widths,
            sizes: sizes,
            loading: loading,
            disable_controls: true,
            video_autoplay: true,
            video_loop: true,
            video_id: media[1].id,
            section_id: section.id,
            id: secondary_media_id
          -%}
      {%- endcase -%}
    {%- endif -%}
  </div>
  <a href="{{ href_product_url }}" class="full-unstyled-link link-wrap z-2" aria-labelledby="MediaStandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}" id="MediaStandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}">
    <span class="visually-hidden">{{ card_product.title | escape }}</span>
  </a>
</card-media>
