{%- comment -%}
  Calvium — "NEW IN" 4-up category tiles with white pill label.
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

<section
  class="cm-section {% if section.settings.tone == 'cream' %}cm-section--cream{% elsif section.settings.tone == 'dark' %}cm-section--dark{% endif %}"
  data-cm-reveal
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="cm-container">
    <div class="cm-section__head">
      <h2 class="cm-section__title">{{ section.settings.heading | default: 'NEW IN' }}</h2>
    </div>

    {%- assign is_carousel = false -%}
    {%- if section.blocks.size > 1 -%}{%- assign is_carousel = true -%}{%- endif -%}

    <div class="cm-cats {% if is_carousel %}cm-cats--carousel{% endif %}" aria-roledescription="{% if is_carousel %}carousel{% endif %}">
      <div class="cm-cats__track">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="cm-cat" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}"
                   srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                   sizes="(max-width: 900px) 50vw, 25vw"
                   alt="{{ block.settings.label | escape }}"
                   width="600" height="800" loading="lazy">
            {%- endif -%}
            <span class="cm-cat__label">{{ block.settings.label | default: 'Category' }}</span>
          </a>
        {%- endfor -%}
        {%- if is_carousel -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="cm-cat" data-cm-cat-dup="true" aria-hidden="true" tabindex="-1">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}"
                     srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                     sizes="(max-width: 900px) 50vw, 25vw"
                     alt=""
                     width="600" height="800" loading="lazy">
              {%- endif -%}
              <span class="cm-cat__label">{{ block.settings.label | default: 'Category' }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Calvium — New In tiles",
  "class": "shopify-section--cm-new-in",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW IN" },
    { "type": "select", "id": "tone", "label": "Background tone",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ], "default": "light"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (3:4)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Calvium — New In tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "WORK-READY" } },
        { "type": "tile", "settings": { "label": "EVERYDAY SIGNATURES" } },
        { "type": "tile", "settings": { "label": "CARRY-ONS" } },
        { "type": "tile", "settings": { "label": "AFTER-HOURS" } }
      ]
    }
  ]
}
{% endschema %}
