{%- comment -%}
  Calvium — "MOST-LOVED STYLES" collection slider (Miraggio premium small-font look).
  Standalone section — does not touch existing featured-collection sections.
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

{%- assign coll = collections[section.settings.collection] -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections['best-sellers'] -%}
{%- endif -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections['new-arrivals'] -%}
{%- endif -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections.all -%}
{%- endif -%}
{%- comment -%} Exclude the current product on PDPs so recommendations are relevant. {%- endcomment -%}
<section
  class="cm-section {% if section.settings.tone == 'cream' %}cm-section--cream{% elsif section.settings.tone == 'dark' %}cm-section--dark{% endif %}"
  data-cm-reveal
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="cm-container">
    <div class="cm-section__head">
      <h2 class="cm-section__title cm-section__title--left">{{ section.settings.heading | default: 'MOST-LOVED STYLES' }}</h2>
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="cm-section__viewall">{{ section.settings.cta_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="cm-slider">
    <div class="cm-slider__viewport">
      <div class="cm-slider__track">
        {%- if coll and coll.products.size > 0 -%}
          {%- assign shown = 0 -%}
          {%- for p in coll.products -%}
            {%- if shown >= section.settings.max_products -%}{%- break -%}{%- endif -%}
            {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- render 'cm-product-card', product: p, show_percent: section.settings.show_percent, show_swatches: section.settings.show_swatches, max_swatches: section.settings.max_swatches, show_atc: section.settings.show_atc -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <article class="cm-card">
              <div class="cm-card__figure" style="background: var(--cm-cream-deep);">
                <div class="cm-card__badges"><span class="cm-card__badge">25% OFF</span></div>
              </div>
              <a class="cm-card__title" href="#">Sample Bag {{ forloop.index }}</a>
              <div class="cm-card__price-row">
                <span class="cm-card__price">₹2,609</span>
                <span class="cm-card__price cm-card__price--regular">₹3,499</span>
                <span class="cm-card__price cm-card__price--percent">25% OFF</span>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Calvium — Most-Loved",
  "class": "shopify-section--cm-most-loved",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "MOST-LOVED STYLES" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 4, "max": 20, "step": 1, "default": 12 },
    { "type": "text", "id": "cta_label", "label": "View-all label", "default": "View all" },
    { "type": "url", "id": "cta_url", "label": "View-all link" },
    { "type": "select", "id": "tone", "label": "Background tone",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ], "default": "light"
    },
    { "type": "checkbox", "id": "show_percent", "label": "Show % OFF badge/label", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "range", "id": "max_swatches", "label": "Max swatches", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_atc", "label": "Show hover Add-to-Cart", "default": true },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "presets": [ { "name": "Calvium — Most-Loved" } ]
}
{% endschema %}
