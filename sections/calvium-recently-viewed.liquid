{%- comment -%}
  Calvium — "Recommended for you" carousel.

  Visually identical to `calvium-most-loved` (cm-section / cm-slider / cm-product-card),
  but with a client-side reorder pass driven by `_halo_recently_viewed` in localStorage:

    1. SSR renders up to `max_products` products from the fallback collection
       (cascade: chosen collection → best-sellers → new-arrivals → all),
       excluding the current product on PDPs.
    2. `<calvium-recently-viewed>` (in calvium-miraggio.js) reads the recently-viewed
       list, filters the current product, and:
         - moves any recently-viewed products it finds in the SSR track to the front,
           preserving most-recent-first order.
         - Fisher–Yates shuffles the remaining fallback cards so non-recently-viewed
           visitors get a randomised feed rather than the same static order.
       Total count stays constant — reorder only, no add/remove.

  If a recently-viewed product isn't in the SSR pool (rare when fallback is `all`
  since Liquid iterates the first 50 products), it simply won't move to the front —
  but the carousel still shows `max_products` items every time.
{%- endcomment -%}

{%- assign coll = collections[section.settings.collection] -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections['best-sellers'] -%}
{%- endif -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections['new-arrivals'] -%}
{%- endif -%}
{%- if coll == blank or coll.products.size == 0 -%}
  {%- assign coll = collections.all -%}
{%- endif -%}

<section
  class="cm-section {% if section.settings.tone == 'cream' %}cm-section--cream{% elsif section.settings.tone == 'dark' %}cm-section--dark{% endif %}"
  data-cm-reveal
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="cm-container">
    <div class="cm-section__head">
      <h2 class="cm-section__title cm-section__title--left">{{ section.settings.heading | default: 'RECOMMENDED FOR YOU' }}</h2>
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="cm-section__viewall">{{ section.settings.cta_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="cm-slider">
    <div class="cm-slider__viewport">
      <calvium-recently-viewed
        class="cm-slider__track"
        data-max-products="{{ section.settings.max_products }}"
        {%- if product and product.id -%}
          data-current-product-id="{{ product.id }}"
        {%- endif -%}
      >
        {%- if coll and coll.products.size > 0 -%}
          {%- assign shown = 0 -%}
          {%- for p in coll.products -%}
            {%- if shown >= section.settings.max_products -%}{%- break -%}{%- endif -%}
            {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- render 'cm-product-card', product: p, show_percent: section.settings.show_percent, show_swatches: section.settings.show_swatches, max_swatches: section.settings.max_swatches, show_atc: section.settings.show_atc -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <article class="cm-card">
              <div class="cm-card__figure" style="background: var(--cm-cream-deep);"></div>
              <a class="cm-card__title" href="#">Sample {{ forloop.index }}</a>
              <div class="cm-card__price-row">
                <span class="cm-card__price">₹0</span>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </calvium-recently-viewed>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Calvium — Recommended (recently viewed)",
  "class": "shopify-section--cm-recently-viewed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "RECOMMENDED FOR YOU" },
    { "type": "collection", "id": "collection", "label": "Fallback collection (used to fill remaining slots when the visitor has fewer recently-viewed products than the max shown)" },
    { "type": "range", "id": "max_products", "label": "Products shown (constant)", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "text", "id": "cta_label", "label": "View-all label", "default": "View all" },
    { "type": "url", "id": "cta_url", "label": "View-all link" },
    { "type": "select", "id": "tone", "label": "Background tone",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ], "default": "light"
    },
    { "type": "checkbox", "id": "show_percent", "label": "Show % OFF badge/label", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "range", "id": "max_swatches", "label": "Max swatches", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_atc", "label": "Show hover Add-to-Cart", "default": true },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 40 }
  ],
  "presets": [ { "name": "Calvium — Recommended (recently viewed)" } ]
}
{% endschema %}
