{%- comment -%}
  Calvium — Wishlist page.
  Reads localStorage.wishlistItem client-side, fetches each product's card
  via /products/{handle}?view=calvium_wishlist_card, and appends to the grid.
  Also updates on `add:wishlist-item` / `remove:wishlist-item` events (dispatched
  by global.js's Wishlist custom element).
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

<section class="cm-section cm-wishpage" data-cm-reveal
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="cm-container">
    <header class="cm-wishpage__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cm-wishpage__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="cm-wishpage__title">{{ section.settings.heading | default: 'Your Wishlist' }}</h1>
      <p class="cm-wishpage__count" data-cm-wishcount>0 pieces saved</p>
    </header>

    <div class="cm-wishpage__toolbar" data-cm-wishtoolbar hidden>
      <button type="button" class="cm-wishpage__addall" data-cm-wishaddall>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6h15l-1.5 9H8L6.5 3H2"/><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg>
        <span data-cm-wishaddall-label>Add all to cart</span>
      </button>
      <a
        class="cm-wishpage__share"
        href="mailto:?subject=My Calvium Wishlist&body=Take a look at my wishlist on Calvium: {{ shop.url }}{{ page.url }}"
        data-cm-wishshare
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3 7 9 6 9-6"/></svg>
        <span>Share</span>
      </a>
      <button type="button" class="cm-wishpage__clear" data-cm-wishclear>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-9 0v14h10V6"/></svg>
        <span>Clear all</span>
      </button>
    </div>

    <div class="cm-wishpage__grid" data-cm-wishgrid></div>

    <div class="cm-wishpage__empty" data-cm-wishempty>
      <div class="cm-wishpage__empty-message">
        <svg class="cm-wishpage__empty-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M32 55C22 47 11 39 11 26a10 10 0 0 1 18-6l3 3 3-3a10 10 0 0 1 18 6c0 13-11 21-21 29Z"/>
        </svg>
        <h2 class="cm-wishpage__empty-title">Your wishlist is empty</h2>
        <p class="cm-wishpage__empty-body">Save your favourites by tapping the heart icon on any product — they'll show up here for easy checkout.</p>
        <a href="/collections/all" class="cm-wishpage__empty-cta">Continue Shopping</a>
      </div>

      {%- liquid
        assign feat_coll = collections['best-sellers']
        if feat_coll == blank or feat_coll.products.size == 0
          assign feat_coll = collections['new-arrivals']
        endif
        if feat_coll == blank or feat_coll.products.size == 0
          assign feat_coll = collections.all
        endif
      -%}
      {%- if feat_coll and feat_coll.products.size > 0 -%}
        <div class="cm-wishpage__empty-picks">
          <h3 class="cm-wishpage__empty-picks-title">You might like</h3>
          <div class="cm-wishpage__empty-picks-grid">
            {%- assign shown = 0 -%}
            {%- for p in feat_coll.products -%}
              {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
              {%- render 'cm-product-card', product: p, show_percent: true, show_swatches: true, max_swatches: 4, show_atc: false -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="cm-wishpage__loading" data-cm-wishloading hidden>
      <span class="cm-wishpage__spinner" aria-hidden="true"></span>
      <span>Loading your saved styles…</span>
    </div>
  </div>
</section>

<script>
  (function () {
    var VIEW_NAME = 'calvium_wishlist_card';
    var LEGACY_VIEW = 'block_wishlist_card';
    var root = document.querySelector('.cm-wishpage');
    if (!root) return;

    var grid = root.querySelector('[data-cm-wishgrid]');
    var empty = root.querySelector('[data-cm-wishempty]');
    var toolbar = root.querySelector('[data-cm-wishtoolbar]');
    var loading = root.querySelector('[data-cm-wishloading]');
    var countEl = root.querySelector('[data-cm-wishcount]');
    var clearBtn = root.querySelector('[data-cm-wishclear]');

    function readList() {
      try { return JSON.parse(localStorage.getItem('wishlistItem') || '[]'); } catch (_) { return []; }
    }
    function writeList(list) {
      localStorage.setItem('wishlistItem', JSON.stringify(list));
    }

    function updateCount(n) {
      countEl.textContent = n === 0 ? 'Nothing saved yet' : (n + ' ' + (n === 1 ? 'piece' : 'pieces') + ' saved');
    }

    function showEmpty(isEmpty) {
      empty.hidden = !isEmpty;
      toolbar.hidden = isEmpty;
      grid.hidden = isEmpty;
    }

    async function fetchCard(handle) {
      var tries = [VIEW_NAME, LEGACY_VIEW];
      for (var i = 0; i < tries.length; i++) {
        try {
          var res = await fetch('/products/' + encodeURIComponent(handle) + '?view=' + tries[i], { credentials: 'same-origin' });
          if (!res.ok) continue;
          var html = await res.text();
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          // pick the wrapper we render server-side; fall back to first cm-card
          var wrap = tmp.querySelector('[data-cm-wishlist-card]') || tmp.querySelector('.cm-card') || tmp.querySelector('.card-product, .card-product-flex, article');
          if (wrap) return wrap;
        } catch (e) { /* try next */ }
      }
      return null;
    }

    async function render() {
      var list = readList();
      updateCount(list.length);

      if (list.length === 0) {
        grid.innerHTML = '';
        showEmpty(true);
        return;
      }

      showEmpty(false);
      loading.hidden = false;
      grid.innerHTML = '';

      // Fetch all in parallel; render in order
      var results = await Promise.all(list.map(function (h) { return fetchCard(h); }));
      results.forEach(function (node, idx) {
        if (node) {
          // ensure wishlist button on this card is already in "added" state
          node.querySelectorAll('.wishlist-button').forEach(function (b) { b.classList.add('wishlist-added'); });
          grid.appendChild(node);
        } else {
          // fetch failed for a handle — surface a placeholder with remove option
          var handle = list[idx];
          var ph = document.createElement('div');
          ph.className = 'cm-wishpage__missing';
          ph.innerHTML = '<p>Unable to load <strong>' + handle + '</strong></p>' +
            '<button type="button" data-cm-wishremove="' + handle + '">Remove</button>';
          grid.appendChild(ph);
        }
      });

      loading.hidden = true;
    }

    // Remove-from-wishlist inside a missing-placeholder
    grid.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-cm-wishremove]');
      if (!btn) return;
      var handle = btn.getAttribute('data-cm-wishremove');
      var list = readList().filter(function (h) { return h !== handle; });
      writeList(list);
      document.dispatchEvent(new CustomEvent('remove:wishlist-item', { detail: { handle: handle } }));
      render();
    });

    // Clear all
    clearBtn.addEventListener('click', function () {
      if (!confirm('Remove all items from your wishlist?')) return;
      writeList([]);
      // dispatch a remove event for each so header count updates
      readList().forEach(function () {});
      document.dispatchEvent(new CustomEvent('remove:wishlist-item', { detail: { handle: null, cleared: true } }));
      // Also directly update global count if provided
      if (typeof window.checkWishlistCountGlobal === 'function') {
        window.checkWishlistCountGlobal([]);
      }
      render();
    });

    // Add all to cart — batch POST to /cart/add.js using variant IDs
    // scraped from the already-rendered cm-product-card ATC buttons.
    var addAllBtn = root.querySelector('[data-cm-wishaddall]');
    var addAllLabel = root.querySelector('[data-cm-wishaddall-label]');
    if (addAllBtn) {
      addAllBtn.addEventListener('click', async function () {
        var atcBtns = grid.querySelectorAll('[data-cm-rec-add][data-variant-id]');
        var items = [];
        atcBtns.forEach(function (b) {
          var vid = b.dataset.variantId;
          if (vid && !b.hasAttribute('disabled')) items.push({ id: Number(vid), quantity: 1 });
        });
        if (items.length === 0) return;

        var original = addAllLabel ? addAllLabel.textContent : '';
        if (addAllLabel) addAllLabel.textContent = 'Adding…';
        addAllBtn.setAttribute('disabled', '');

        try {
          var res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: items })
          });
          if (!res.ok) throw new Error('Cart add failed: ' + res.status);
          if (addAllLabel) addAllLabel.textContent = 'Added ✓';
          setTimeout(function () {
            // Open the cart drawer if available; otherwise nav to cart page
            var drawerOpen = document.querySelector('[data-cm-cart-open]');
            if (drawerOpen && document.querySelector('[data-cm-cart]')) {
              drawerOpen.click();
              if (addAllLabel) addAllLabel.textContent = original || 'Add all to cart';
              addAllBtn.removeAttribute('disabled');
            } else {
              window.location.href = '/cart';
            }
          }, 700);
        } catch (e) {
          console.warn('[cm-wishlist] add all failed', e);
          if (addAllLabel) addAllLabel.textContent = 'Try again';
          setTimeout(function () {
            if (addAllLabel) addAllLabel.textContent = original || 'Add all to cart';
            addAllBtn.removeAttribute('disabled');
          }, 1400);
        }
      });
    }

    // Re-render when items are added/removed elsewhere on the site
    document.addEventListener('add:wishlist-item', render);
    document.addEventListener('remove:wishlist-item', render);

    // Also react to another tab flipping localStorage
    window.addEventListener('storage', function (e) {
      if (e.key === 'wishlistItem') render();
    });

    // Kick off
    render();
  })();
</script>

{% schema %}
{
  "name": "Calvium — Wishlist page",
  "class": "shopify-section--cm-wishpage",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SAVED FOR LATER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Wishlist" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "presets": [
    { "name": "Calvium — Wishlist page" }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
