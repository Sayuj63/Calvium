{%- comment -%}
  Calvium — Shop by Style.
  Tabbed collection browser: click a pill to switch between collections,
  each showing product cards (cm-product-card, wired to wishlist + swatches).
  Replaces the OLD Swytch "featured-collection-list" (Shop By Style tabs).
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

<section
  class="cm-section cm-sbs {% if section.settings.tone == 'cream' %}cm-section--cream{% elsif section.settings.tone == 'dark' %}cm-section--dark{% endif %}"
  data-cm-reveal
  data-cm-sbs
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="cm-container">
    <div class="cm-section__head">
      <h2 class="cm-section__title cm-section__title--left">{{ section.settings.heading | default: 'SHOP BY STYLE' }}</h2>
      {%- if section.settings.viewall_url != blank -%}
        <a href="{{ section.settings.viewall_url }}" class="cm-section__viewall">{{ section.settings.viewall_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.subheading != blank -%}
      <p class="cm-sbs__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cm-sbs__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Shop by style' }}">
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- assign label = block.settings.label | default: coll.title | default: 'Style' -%}
          <button
            type="button"
            role="tab"
            id="cm-sbs-tab-{{ section.id }}-{{ forloop.index0 }}"
            aria-controls="cm-sbs-panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            class="cm-sbs__tab {% if forloop.first %}is-active{% endif %}"
            data-cm-sbs-tab="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >{{ label }}</button>
        {%- endfor -%}
      </div>

      <div class="cm-sbs__panels">
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- assign label = block.settings.label | default: coll.title | default: 'Style' -%}
          <div
            role="tabpanel"
            id="cm-sbs-panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-labelledby="cm-sbs-tab-{{ section.id }}-{{ forloop.index0 }}"
            class="cm-sbs__panel {% if forloop.first %}is-active{% endif %}"
            data-cm-sbs-panel="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if coll and coll.products.size > 0 -%}
              <div class="cm-sbs__grid">
                {%- for p in coll.products limit: section.settings.max_products -%}
                  {%- render 'cm-product-card',
                       product: p,
                       show_percent: section.settings.show_percent,
                       show_swatches: section.settings.show_swatches,
                       max_swatches: section.settings.max_swatches,
                       show_atc: section.settings.show_atc -%}
                {%- endfor -%}
              </div>

              <div class="cm-sbs__tabcta">
                <a href="{{ block.settings.link | default: coll.url | default: '/collections/all' }}"
                   class="cm-sbs__tabbtn">
                  Shop all {{ label }}
                </a>
              </div>
            {%- else -%}
              <p class="cm-sbs__empty">
                {%- if coll -%}
                  "{{ coll.title }}" has no products yet.
                {%- else -%}
                  Assign a collection to this tab in the theme editor.
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="cm-sbs__empty">Add tabs in the theme editor — one per collection.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Calvium — Shop by Style",
  "class": "shopify-section--cm-shop-by-style",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP BY STYLE" },
    { "type": "text", "id": "subheading", "label": "Subheading (optional)" },
    { "type": "text", "id": "viewall_label", "label": "View-all label", "default": "View all" },
    { "type": "url",  "id": "viewall_url",   "label": "View-all link" },
    { "type": "select", "id": "tone", "label": "Background tone",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark",  "label": "Dark"  }
      ], "default": "light"
    },
    { "type": "range",    "id": "max_products",  "label": "Products per tab", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_percent",  "label": "Show % off badge", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "range",    "id": "max_swatches",  "label": "Max swatches", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_atc",      "label": "Show Add-to-Cart hover", "default": true },
    { "type": "range",    "id": "padding_top",   "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range",    "id": "padding_bottom","label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text",       "id": "label",      "label": "Tab label",       "info": "Falls back to collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url",        "id": "link",       "label": "\"Shop all\" link (optional)", "info": "Falls back to the collection URL." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Calvium — Shop by Style",
      "settings": { "heading": "SHOP BY STYLE" },
      "blocks": [
        { "type": "tab" }, { "type": "tab" }, { "type": "tab" }, { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
