{%- comment -%}
  Calvium — Miraggio-style announcement bar.
  Static by default. Only rotates if you add multiple messages AND
  turn on "Auto-rotate" in section settings.
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

{%- assign auto_rotate = section.settings.auto_rotate -%}
{%- assign block_count = section.blocks.size -%}
{%- comment -%}
  Auto-enable rotation if there are multiple messages, unless merchant has
  explicitly turned auto_rotate off — prevents the stacked-3-lines look.
{%- endcomment -%}
{%- if block_count > 1 and auto_rotate == nil -%}
  {%- assign auto_rotate = true -%}
{%- endif -%}
{%- assign show_nav = false -%}
{%- if auto_rotate and block_count > 1 -%}{%- assign show_nav = true -%}{%- endif -%}

<aside
  class="cm-ann {% unless show_nav %}cm-ann--static{% endunless %}"
  {% if auto_rotate %}data-cm-ann data-cm-interval="{{ section.settings.interval | default: 4 }}"{% endif %}
  style="background: {{ section.settings.bg_color | default: '#0a0a0a' }}; color: {{ section.settings.text_color | default: '#ffffff' }};"
>
  <div class="cm-ann__track">
    {%- if show_nav -%}
      <button type="button" class="cm-ann__nav" data-cm-ann-prev aria-label="Previous">
        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 2l-5 5 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}

    <div class="cm-ann__viewport" aria-live="polite">
      {%- if block_count > 0 -%}
        {%- for block in section.blocks -%}
          <div class="cm-ann__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | default: 'Free shipping across India above ₹999' }}</a>
            {%- else -%}
              <span>{{ block.settings.text | default: 'Free shipping across India above ₹999' }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="cm-ann__slide is-active">
          <span>{{ section.settings.default_text | default: 'Free shipping across India above ₹999' }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if show_nav -%}
      <button type="button" class="cm-ann__nav" data-cm-ann-next aria-label="Next">
        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Calvium — Announcement",
  "class": "shopify-section--cm-ann",
  "tag": "aside",
  "settings": [
    { "type": "text", "id": "default_text", "label": "Fallback message", "default": "Free shipping across India above ₹999" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate through messages", "default": false, "info": "Turn on to cycle through multiple messages. Leave off to display just the first message statically." },
    { "type": "range", "id": "interval", "label": "Auto-rotate every (s)", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Free shipping across India above ₹999" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Calvium — Announcement",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping across India above ₹999" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
