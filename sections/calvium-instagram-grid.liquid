{%- comment -%}
  Calvium — Instagram-style social grid.
  6-tile (or 8) grid of images with hover overlay + optional link.
  Section head shows brand handle + follow CTA. Replaces the OLD Swytch
  media-gallery Instagram grid.
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}

<section
  class="cm-section cm-igfeed {% if section.settings.tone == 'cream' %}cm-section--cream{% elsif section.settings.tone == 'dark' %}cm-section--dark{% endif %}"
  data-cm-reveal
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="cm-container">
    <div class="cm-igfeed__head">
      <div class="cm-igfeed__title-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cm-igfeed__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-igfeed__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.handle != blank -%}
        <a
          href="{{ section.settings.follow_link | default: '#' }}"
          class="cm-igfeed__follow"
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
          </svg>
          <span>{{ section.settings.handle }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cm-igfeed__grid cm-igfeed__grid--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          {%- assign tag = 'a' -%}
          {%- unless block.settings.link != blank -%}{%- assign tag = 'div' -%}{%- endunless -%}
          <{{ tag }}
            class="cm-igfeed__tile"
            {% if tag == 'a' %}
              href="{{ block.settings.link }}"
              {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
              aria-label="{{ block.settings.alt | default: 'Instagram post' | escape }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 900 }} 900w"
                sizes="(max-width: 749px) 33vw, 25vw"
                alt="{{ block.settings.alt | default: 'Calvium on Instagram' | escape }}"
                width="600" height="600" loading="lazy"
              >
            {%- else -%}
              <span class="cm-igfeed__ph" aria-hidden="true"></span>
            {%- endif -%}
            <span class="cm-igfeed__overlay" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
            </span>
            {%- if block.settings.caption != blank -%}
              <span class="cm-igfeed__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="cm-igfeed__empty">Add images in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Calvium — Instagram grid",
  "class": "shopify-section--cm-igfeed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP THE FEED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On Instagram" },
    { "type": "text", "id": "handle", "label": "Handle (e.g. @calvium)", "default": "@calvium.in" },
    { "type": "url", "id": "follow_link", "label": "Follow link" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ], "default": "4"
    },
    { "type": "select", "id": "tone", "label": "Background",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "dark",  "label": "Dark" }
      ], "default": "light"
    },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (1:1 square)" },
        { "type": "url", "id": "link", "label": "Link (Instagram post / product)" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Calvium — Instagram grid",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
