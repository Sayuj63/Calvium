{%- comment -%}
  Calvium — Miraggio-style sticky header.
  Renders from a Shopify Link List (pick your menu in the section settings),
  with optional per-parent mega-menu columns you can define as blocks.
  Namespaced under .cm-* — safe alongside the existing Halo header.
{%- endcomment -%}
{{ 'calvium-miraggio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calvium-miraggio.js' | asset_url }}" defer="defer"></script>

{%- assign menu = linklists[section.settings.menu] -%}

<header class="cm-header {% if section.settings.sticky %}is-sticky{% endif %}" data-cm-header>
  <div class="cm-container cm-header__row">
    <div class="cm-header__left">
      <button type="button" class="cm-icon-btn cm-mobile-toggle" data-cm-mobile-open aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <nav class="cm-nav" aria-label="Primary">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            {%- assign has_children = false -%}
            {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}

            {%- comment -%} Match mega-menu block (if any) by label {%- endcomment -%}
            {%- assign mega_block = nil -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega' -%}
                {%- assign block_key = block.settings.parent_label | strip | downcase -%}
                {%- assign link_key = link.title | strip | downcase -%}
                {%- if block_key == link_key -%}{%- assign mega_block = block -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign has_mega = false -%}
            {%- if mega_block != nil -%}
              {%- for i in (1..4) -%}
                {%- assign head_k = 'col' | append: i | append: '_heading' -%}
                {%- assign links_k = 'col' | append: i | append: '_links' -%}
                {%- if mega_block.settings[head_k] != blank or mega_block.settings[links_k] != blank -%}
                  {%- assign has_mega = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- assign show_dropdown = false -%}
            {%- if has_mega or has_children -%}{%- assign show_dropdown = true -%}{%- endif -%}

            <div class="cm-nav__item" data-cm-mega>
              {%- if show_dropdown -%}
                <a href="{{ link.url }}" class="cm-nav__trigger" aria-haspopup="true">
                  <span>{{ link.title }}</span>
                  <svg class="cm-nav__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- else -%}
                <a href="{{ link.url }}" class="cm-nav__trigger">
                  <span>{{ link.title }}</span>
                </a>
              {%- endif -%}

              {%- if has_mega -%}
                {%- assign col_count = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign head_k = 'col' | append: i | append: '_heading' -%}
                  {%- assign links_k = 'col' | append: i | append: '_links' -%}
                  {%- if mega_block.settings[head_k] != blank or mega_block.settings[links_k] != blank -%}
                    {%- assign col_count = col_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}

                <div class="cm-mega cm-mega--{{ col_count }}" role="menu">
                  <div class="cm-mega__cols">
                    {%- for i in (1..4) -%}
                      {%- assign head_k = 'col' | append: i | append: '_heading' -%}
                      {%- assign links_k = 'col' | append: i | append: '_links' -%}
                      {%- assign img_k = 'col' | append: i | append: '_image' -%}
                      {%- if mega_block.settings[head_k] != blank or mega_block.settings[links_k] != blank -%}
                        {%- assign col_img = '' -%}
                        {%- if mega_block.settings[img_k] != blank -%}
                          {%- assign col_img = mega_block.settings[img_k] | image_url: width: 900 -%}
                        {%- endif -%}
                        <div class="cm-mega__col" data-cm-mega-col data-col-image="{{ col_img }}">
                          {%- if mega_block.settings[head_k] != blank -%}
                            <p class="cm-mega__heading">{{ mega_block.settings[head_k] }}</p>
                          {%- endif -%}
                          {%- if mega_block.settings[links_k] != blank -%}
                            {%- assign lines = mega_block.settings[links_k] | newline_to_br | split: '<br />' -%}
                            <ul class="cm-mega__list">
                              {%- for line in lines -%}
                                {%- assign trimmed = line | strip -%}
                                {%- if trimmed != blank -%}
                                  {%- assign parts = trimmed | split: '|' -%}
                                  {%- assign label = parts[0] | strip -%}
                                  {%- assign href = parts[1] | default: '#' | strip -%}
                                  {%- assign row_image = parts[2] | strip -%}
                                  {%- comment -%} Auto: if no manual image AND href is a collection URL, use its first product's featured image. {%- endcomment -%}
                                  {%- if row_image == blank and href contains '/collections/' -%}
                                    {%- assign _handle_tail = href | split: '/collections/' | last -%}
                                    {%- assign coll_handle = _handle_tail | split: '/' | first | split: '?' | first -%}
                                    {%- if coll_handle != blank and collections[coll_handle].products.size > 0 -%}
                                      {%- assign row_image = collections[coll_handle].products.first.featured_image | image_url: width: 600 | prepend: 'https:' -%}
                                    {%- endif -%}
                                  {%- endif -%}
                                  {%- if row_image == blank -%}{%- assign row_image = col_img -%}{%- endif -%}
                                  {%- assign row_is_url = false -%}
                                  {%- if row_image contains '://' or row_image contains '//' -%}{%- assign row_is_url = true -%}{%- endif -%}
                                  {%- if row_image != blank and row_is_url == false and row_image contains '.' -%}
                                    {%- assign row_image = row_image | asset_url -%}
                                  {%- endif -%}
                                  <li>
                                    <a href="{{ href }}" data-cm-mega-link data-hover-image="{{ row_image }}">{{ label }}</a>
                                  </li>
                                {%- endif -%}
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                    <div class="cm-mega__preview">
                      {%- if mega_block.settings.default_preview != blank -%}
                        <img src="{{ mega_block.settings.default_preview | image_url: width: 1200 }}" alt="{{ link.title | escape }}" width="600" height="750" data-cm-mega-img loading="lazy">
                      {%- else -%}
                        <img src="" alt="" data-cm-mega-img loading="lazy" width="600" height="750" style="opacity:0;">
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- elsif has_children -%}
                {%- comment -%} Simple submenu — use link_list children {%- endcomment -%}
                <div class="cm-mega cm-mega--1" role="menu">
                  <div class="cm-mega__cols" style="grid-template-columns: 1fr;">
                    <div class="cm-mega__col">
                      <ul class="cm-mega__list">
                        {%- for child in link.links -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback: legacy block-based links (kept for compatibility) {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'link' -%}
              <div class="cm-nav__item">
                <a href="{{ block.settings.link | default: '#' }}" class="cm-nav__trigger"><span>{{ block.settings.label }}</span></a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="cm-header__logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_w = section.settings.logo_width | default: 130 -%}
        {%- assign logo_w2x = logo_w | times: 2 -%}
        {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
        <img
          src="{{ section.settings.logo | image_url: width: logo_w2x }}"
          srcset="{{ section.settings.logo | image_url: width: logo_w }} 1x, {{ section.settings.logo | image_url: width: logo_w2x }} 2x"
          alt="{{ logo_alt | escape }}"
          width="{{ logo_w }}"
          height="auto"
          style="width: {{ logo_w }}px; height: auto; max-height: 48px; object-fit: contain;"
        >
      {%- else -%}
        <span class="cm-header__brandtext">{{ section.settings.brand_name | default: shop.name | default: 'CALVIUM' | upcase }}</span>
      {%- endif -%}
    </a>

    <div class="cm-header__right">
      <button type="button" class="cm-icon-btn" data-search-open aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      {%- liquid
        assign cm_wishlist_href = ''
        if section.settings.wishlist_url != blank
          assign cm_wishlist_href = section.settings.wishlist_url
        elsif pages['wishlist'] and pages['wishlist'].url != blank
          assign cm_wishlist_href = pages['wishlist'].url
        elsif pages['wish-list'] and pages['wish-list'].url != blank
          assign cm_wishlist_href = pages['wish-list'].url
        else
          assign cm_wishlist_href = '/account'
        endif
      -%}
      <a href="{{ cm_wishlist_href }}" class="cm-icon-btn cm-icon-btn--wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
        <span class="cm-wish-bubble wishlist-count-bubble" style="display: none;" aria-hidden="true">
          <span data-wishlist-count>0</span>
        </span>
      </a>
      <button type="button" class="cm-icon-btn cm-icon-btn--cart" data-cm-cart-open aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6h15l-1.5 9H8L6.5 3H2"/><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="cm-cart-bubble">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>
  </div>
</header>

<aside class="cm-mobile-drawer" data-cm-mobile-drawer aria-hidden="true">
  <div class="cm-cart__overlay" data-cm-mobile-close></div>
  <div class="cm-mobile-drawer__panel">
    <div class="cm-mobile-drawer__head">
      <span style="font-family: var(--cm-font-body); font-weight: 500; letter-spacing: 0; font-size: 15px;">Menu</span>
      <button type="button" class="cm-icon-btn" data-cm-mobile-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
      </button>
    </div>
    {%- if menu != blank -%}
      {%- for link in menu.links -%}
        {%- comment -%} Match any mega block by parent label (same logic as desktop). {%- endcomment -%}
        {%- assign mega_block = nil -%}
        {%- assign link_key = link.title | downcase | strip | replace: ' ', '-' | replace: '&', 'and' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega' -%}
            {%- assign block_key = block.settings.parent_label | default: '' | downcase | strip | replace: ' ', '-' | replace: '&', 'and' -%}
            {%- if block_key == link_key -%}{%- assign mega_block = block -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign has_mega = false -%}
        {%- if mega_block != nil -%}
          {%- for i in (1..4) -%}
            {%- assign head_k = 'col' | append: i | append: '_heading' -%}
            {%- assign links_k = 'col' | append: i | append: '_links' -%}
            {%- if mega_block.settings[head_k] != blank or mega_block.settings[links_k] != blank -%}
              {%- assign has_mega = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign has_children = false -%}
        {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}

        {%- if has_mega -%}
          <details class="cm-mobile-drawer__group">
            <summary class="cm-mobile-drawer__link cm-mobile-drawer__summary">
              <span>{{ link.title }}</span>
              <svg class="cm-mobile-drawer__chev" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="cm-mobile-drawer__submenu">
              {%- for i in (1..4) -%}
                {%- assign head_k = 'col' | append: i | append: '_heading' -%}
                {%- assign links_k = 'col' | append: i | append: '_links' -%}
                {%- if mega_block.settings[head_k] != blank or mega_block.settings[links_k] != blank -%}
                  {%- if mega_block.settings[head_k] != blank -%}
                    <p class="cm-mobile-drawer__subheading">{{ mega_block.settings[head_k] }}</p>
                  {%- endif -%}
                  {%- if mega_block.settings[links_k] != blank -%}
                    {%- assign lines = mega_block.settings[links_k] | newline_to_br | split: '<br />' -%}
                    {%- for line in lines -%}
                      {%- assign trimmed = line | strip -%}
                      {%- if trimmed != blank -%}
                        {%- assign parts = trimmed | split: '|' -%}
                        {%- assign label = parts[0] | strip -%}
                        {%- assign href = parts[1] | default: '#' | strip -%}
                        <a href="{{ href }}" class="cm-mobile-drawer__sublink">{{ label }}</a>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </details>
        {%- elsif has_children -%}
          <details class="cm-mobile-drawer__group">
            <summary class="cm-mobile-drawer__link cm-mobile-drawer__summary">
              <span>{{ link.title }}</span>
              <svg class="cm-mobile-drawer__chev" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="cm-mobile-drawer__submenu">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" class="cm-mobile-drawer__sublink">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="cm-mobile-drawer__link">
            <span>{{ link.title }}</span>
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="cm-mobile-drawer__link">
            <span>{{ block.settings.label }}</span>
            <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</aside>

{%- render 'calvium-search-overlay' -%}

{% schema %}
{
  "name": "Calvium — Header",
  "class": "shopify-section--cm-header",
  "tag": "div",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Pick a Shopify menu — its links (and their submenus) will render automatically. No need to add link blocks." },
    { "type": "text", "id": "brand_name", "label": "Brand text (used if no logo)", "default": "CALVIUM" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width (px)", "min": 60, "max": 260, "step": 5, "default": 130 },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page URL" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ],
  "blocks": [
    {
      "type": "mega",
      "name": "Mega-menu for parent",
      "settings": [
        { "type": "paragraph", "content": "Match a parent link in your menu to render a mega-menu when hovered. Enter the exact parent-link label below." },
        { "type": "text", "id": "parent_label", "label": "Parent link label", "default": "Shop by Category", "info": "Must match a top-level menu link title exactly." },
        { "type": "image_picker", "id": "default_preview", "label": "Default preview image" },

        { "type": "text", "id": "col1_heading", "label": "Column 1 heading" },
        { "type": "textarea", "id": "col1_links", "label": "Column 1 links", "info": "One per line — format: `Label | /link | image-filename.jpg`" },
        { "type": "image_picker", "id": "col1_image", "label": "Column 1 default image" },

        { "type": "text", "id": "col2_heading", "label": "Column 2 heading" },
        { "type": "textarea", "id": "col2_links", "label": "Column 2 links" },
        { "type": "image_picker", "id": "col2_image", "label": "Column 2 default image" },

        { "type": "text", "id": "col3_heading", "label": "Column 3 heading" },
        { "type": "textarea", "id": "col3_links", "label": "Column 3 links" },
        { "type": "image_picker", "id": "col3_image", "label": "Column 3 default image" },

        { "type": "text", "id": "col4_heading", "label": "Column 4 heading" },
        { "type": "textarea", "id": "col4_links", "label": "Column 4 links" },
        { "type": "image_picker", "id": "col4_image", "label": "Column 4 default image" }
      ]
    },
    {
      "type": "link",
      "name": "Legacy link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Menu item" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Calvium — Header",
      "blocks": [
        {
          "type": "mega",
          "settings": {
            "parent_label": "Shop by Category",
            "col1_heading": "Bags",
            "col1_links": "Tote Bags | /collections/tote-bags\nCrossbody Bags | /collections/crossbody-bags\nShoulder Bags | /collections/shoulder-bags\nBackpacks | /collections/backpacks",
            "col2_heading": "Small Leather",
            "col2_links": "Wallets & Card Holders | /collections/wallets\nClutches | /collections/clutches\nPouches | /collections/pouches"
          }
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
